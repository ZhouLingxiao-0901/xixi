page {
  --primary: #6C63FF;
  --primary-light: #8B85FF;
  --accent: #FF6B9D;
  --success: #4ECDC4;
  --warning: #FFD93D;
  --bg: #f5f0ff;
  --card: #ffffff;
  --text: #2d2d44;
  --text-secondary: #8888a0;
  --border: #eee;
  --radius: 16rpx;
  --shadow: 0 4rpx 24rpx rgba(108, 99, 255, 0.08);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg);
  color: var(--text);
}

page.dark {
  --bg: #1a1a2e;
  --card: #16213e;
  --text: #e8e8f0;
  --text-secondary: #8888a0;
  --border: #2a2a4a;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.3);
}

.container {
  padding: 20rpx 28rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  transition: transform 0.2s, box-shadow 0.2s;
}

.card:active {
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 40rpx;
  padding: 14rpx 38rpx;
  font-size: 28rpx;
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.slide-up {
  animation: slideUp 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(80rpx); }
  to { opacity: 1; transform: translateY(0); }
}
