.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.stat-card {
  flex: 1;
  background: var(--card);
  border-radius: var(--radius);
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: var(--shadow);
}
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 6rpx; }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title { font-size: 32rpx; font-weight: 700; }
.add-btn { font-size: 28rpx; color: var(--primary); font-weight: 600; }
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: var(--text-secondary); display: block; }
.empty-hint { font-size: 24rpx; color: var(--text-secondary); opacity: 0.6; margin-top: 8rpx; display: block; }

.task-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}
.task-left { margin-right: 16rpx; }
.checkbox {
  width: 44rpx; height: 44rpx;
  border: 3rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.3s;
}
.checkbox.checked { background: var(--success); border-color: var(--success); }
.task-body { flex: 1; }
.task-title { font-size: 28rpx; font-weight: 500; transition: opacity 0.3s; }
.task-title.done { text-decoration: line-through; opacity: 0.4; }
.task-meta { display: flex; gap: 12rpx; margin-top: 8rpx; align-items: center; }
.tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx;
  background: #eee; color: #666;
}
.tag-study { background: #e8f5e9; color: #388e3c; }
.tag-work { background: #e3f2fd; color: #1976d2; }
.tag-leisure { background: #fff3e0; color: #f57c00; }
.tag.active { transform: scale(1.1); font-weight: 700; }
.deadline { font-size: 22rpx; color: var(--text-secondary); }
.task-right { display: flex; flex-direction: column; gap: 8rpx; align-items: center; }
.pin-btn, .del-btn { font-size: 28rpx; padding: 4rpx; }
.pin-btn.pinned { transform: rotate(-45deg); }

.modal {
  position: fixed; inset: 0; z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.modal-mask {
  position: absolute; inset: 0; background: rgba(0,0,0,0.4);
}
.modal-content {
  position: relative; width: 100%;
  background: var(--card); border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx;
}
.modal-title { font-size: 34rpx; font-weight: 700; margin-bottom: 28rpx; display: block; }
.modal-input {
  width: 100%; padding: 20rpx; border: 2rpx solid var(--border);
  border-radius: var(--radius); font-size: 28rpx; margin-bottom: 24rpx;
  box-sizing: border-box;
}
.modal-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.modal-label { font-size: 26rpx; color: var(--text-secondary); min-width: 60rpx; }
.tag-group { display: flex; gap: 12rpx; }
.picker-val { font-size: 26rpx; color: var(--primary); padding: 10rpx 0; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-btns button { flex: 1; }
