.section-title {
  font-size: 26rpx; font-weight: 700; color: var(--text-secondary);
  margin: 28rpx 0 14rpx;
}
.setting-row {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 28rpx; padding: 22rpx 24rpx;
}
.val { color: var(--text-secondary); font-size: 26rpx; }
.arrow { font-size: 36rpx; color: var(--text-secondary); }
.warn-text { font-size: 30rpx; }

.preset-grid {
  display: flex; flex-wrap: wrap; gap: 20rpx;
}
.preset-item {
  width: calc((100% - 40rpx) / 3); text-align: center; padding: 8rpx;
  border-radius: var(--radius); transition: transform 0.2s;
}
.preset-item.selected { transform: scale(1.05); box-shadow: 0 0 0 4rpx var(--primary); }
.preset-preview {
  width: 100%; height: 120rpx; border-radius: var(--radius);
  display: flex; align-items: center; justify-content: center;
}
.preset-emoji { font-size: 48rpx; }
.preset-name { font-size: 22rpx; color: var(--text-secondary); margin-top: 6rpx; display: block; }

.bg-preview {
  height: 160rpx; border-radius: var(--radius); margin-top: 16rpx;
  display: flex; align-items: center; justify-content: center;
}
.preview-tag { color: #fff; background: rgba(0,0,0,0.4); padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 24rpx; }

.footer-text {
  text-align: center; font-size: 22rpx; color: var(--text-secondary);
  margin-top: 60rpx; padding: 30rpx 0;
}
